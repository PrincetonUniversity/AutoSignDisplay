<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- String: heading shown at the top of the main screen. Omit for the
         app's own name. Useful for naming the location a display serves. -->
    <key>DisplayTitle</key>
    <string>Engineering Quad — Lobby</string>

    <!-- Boolean: reduce the main screen to the preset list only -->
    <key>ViewOnlyMode</key>
    <false/>

    <!-- String, at least 6 characters: require this PIN to open Settings.
         A deterrent, not security:
         stored in preferences, not the keychain. -->
    <key>SettingsPIN</key>
    <string>482159</string>

    <!-- Boolean: play the configured stream when the app opens -->
    <key>PlayOnAppOpen</key>
    <true/>

    <!-- String: HLS stream URL to use -->
    <key>StreamURL</key>
    <string>https://example.com/path/to/stream.m3u8</string>

    <!-- Boolean: attempt to resume playback automatically after network interruption -->
    <key>AutoResume</key>
    <true/>

    <!-- Number (real): retry interval in seconds used by the app retry timer (optional) -->
    <key>RetryTimeout</key>
    <real>5.0</real>

    <!-- Array of dicts: predefined stream presets (max 20 entries).
         Each entry has a required URL and an optional Name. When Name is set,
         the app shows it in the Stream Presets list instead of the raw URL.
         For backward compatibility, plain <string> URL entries are still
         accepted (they become name-less presets). -->
    <key>ChannelPresets</key>
    <array>
      <dict>
        <key>Name</key>
        <string>News</string>
        <key>URL</key>
        <string>https://orfe.princeton.edu/live/scenic</string>
      </dict>
      <dict>
        <key>Name</key>
        <string>Scenic</string>
        <key>URL</key>
        <string>https://orfe.princeton.edu/live/scenic</string>
      </dict>
      <dict>
        <!-- Name omitted: the URL will show in the list. -->
        <key>URL</key>
        <string>https://orfe.princeton.edu/live/scenic</string>
      </dict>
    </array>

    <!-- String: default channel URL selected on launch (should match one of the presets) -->
    <key>DefaultChannel</key>
    <string>https://orfe.princeton.edu/live/scenic</string>
  </dict>
</plist>
