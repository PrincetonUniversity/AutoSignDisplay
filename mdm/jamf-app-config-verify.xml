<?xml version="1.0" encoding="UTF-8"?>
<!--
  AutoSignDisplay — Managed App Configuration (first-install verification)

  Purpose: prove that managed configuration is reaching the app on a real
  MDM-managed Apple TV, before locking anything down. Deliberately NOT a kiosk
  payload — SettingsDisabled, ViewOnlyMode and SettingsPIN are all absent so you can
  walk the UI and confirm what landed.

  How to read the result from across the room, with no logs and no console:

    - The heading says "MDM VERIFY — <location>". If it says "AutoSignDisplay"
      instead, the payload did not arrive.
    - The Stream Presets list shows exactly two entries, "Verify Scenic" and
      "Verify Announcements", rather than the app's four built-in channels (News,
      News Plus, Scenic, Announcements).
    - The stream starts on its own, because PlayOnAppOpen is true.
    - Settings > Recovery shows Retry Timeout as 7s. That value is not one of the
      six the on-device UI cycles through, so seeing it proves the number came from
      the payload rather than from a local default.

  The stream URLs are Princeton's own live channels, which redirect to Kaltura HLS
  manifests and need no credentials.

  Then apply jamf-app-config-kiosk.xml to test the locked-down configuration.

  NOTE: the app reads managed configuration at launch. After changing this payload
  in Jamf, force-quit the app (double-press TV, swipe up) or reboot the device —
  otherwise nothing appears to happen. See "Applying a changed payload" in
  README.md.
-->
<plist version="1.0">
<dict>
  <!-- Name the actual display. This is the canary: visible instantly, and unique
       enough that it cannot be confused with the app's own default heading. -->
  <key>DisplayTitle</key>
  <string>MDM VERIFY — Sherrerd Hall</string>

  <key>PlayOnAppOpen</key>
  <true/>

  <key>AutoResume</key>
  <true/>

  <!-- 7 is deliberately not one of the values the Settings screen offers (3, 5, 10,
       15, 30, 60). If the UI displays 7s, the payload is being honored. -->
  <key>RetryTimeout</key>
  <real>7.0</real>

  <key>ChannelPresets</key>
  <array>
    <dict>
      <key>Name</key>
      <string>Verify Scenic</string>
      <key>URL</key>
      <string>https://orfe.princeton.edu/live/scenic</string>
    </dict>
    <dict>
      <key>Name</key>
      <string>Verify Announcements</string>
      <key>URL</key>
      <string>https://orfe.princeton.edu/live/announcements</string>
    </dict>
  </array>

  <key>DefaultChannel</key>
  <string>https://orfe.princeton.edu/live/scenic</string>
</dict>
</plist>
