    <real>5.0</real>

    <key>ChannelPresets</key>
    <array>
      <string>https://test.example.com/channel1.m3u8</string>
      <string>https://test.example.com/channel2.m3u8</string>
      <string>https://test.example.com/channel3.m3u8</string>
    </array>

    <key>DefaultChannel</key>
    <string>https://test.example.com/channel1.m3u8</string>
  </dict>
